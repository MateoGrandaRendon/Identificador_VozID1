# .env.example
# Plantilla del archivo de configuración. SÍ se sube a GitHub (documenta
# qué variables necesita el proyecto) y NUNCA debe contener valores reales.
#
# Las variables VOICE_ID_PIN_* y VOICE_ID_FERNET_KEY las genera:
#     python setup_seguridad.py
# El archivo real (.env) está en .gitignore.

VOICE_ID_PIN_SALT=
VOICE_ID_PIN_HASH=
VOICE_ID_PIN_ITER=
VOICE_ID_FERNET_KEY=

# MongoDB. Local sin credenciales (por defecto):
VOICE_ID_MONGODB_URI=mongodb://127.0.0.1:27017
# Remoto (Atlas u otro): usa mongodb+srv:// o añade tls=true. Un usuario con
# permisos SOLO sobre la base de la app (rol readWrite + dbAdmin en voice_id).
#   VOICE_ID_MONGODB_URI=mongodb+srv://USUARIO:CLAVE@cluster.example.net/?retryWrites=true
VOICE_ID_MONGODB_DB=voice_id
VOICE_ID_MONGODB_TIMEOUT_MS=5000
